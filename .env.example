# Copy to .env for local development. Replace every placeholder.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=commerce_sales
DB_USER=commerce_sales_app
DB_PASSWORD=replace-with-a-local-development-password
DB_URL=jdbc:postgresql://localhost:5432/commerce_sales

JWT_SECRET=replace-with-at-least-32-random-bytes

# First-owner provisioning is disabled by default. Enable only for a controlled
# first deployment after applying the tenant schema migration.
APP_BOOTSTRAP_ENABLED=false
APP_BOOTSTRAP_OWNER_EMAIL=
APP_BOOTSTRAP_OWNER_PASSWORD=
APP_BOOTSTRAP_TENANT_NAME=Demo Tenant

ML_SERVICE_TOKEN=replace-with-a-long-random-token
ML_SERVICE_URL=http://localhost:8000
DB_CONNECT_TIMEOUT=5
DB_SSLMODE=prefer
